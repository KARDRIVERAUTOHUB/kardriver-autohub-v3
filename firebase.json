{
  "firestore": {
    "database": "(default)",
    "location": "asia-southeast1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true,
    "functions": {
      "port": 5001
    },
    "auth": {
      "port": 9099
    },
    "pubsub": {
      "port": 8085
    }
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  }
}
